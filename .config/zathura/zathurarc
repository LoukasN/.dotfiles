set selection-clipboard clipboard
set adjust-open "best-fit"
set pages-per-row 1
set zoom-min 10
set guioptions ""
set incremental-search true
set selection-notification false

# zathurarc-kanagawa-dragon
set font "MartianMono 12"

# base
set default-bg           "#181616" 
set default-fg           "#c5c9c5" 

# statusbar
set statusbar-bg         "#12120f"
set statusbar-fg         "#a6a69c"

# inputbar (only visible if guioptions includes "c")
set inputbar-bg          "#1D1C19"
set inputbar-fg          "#c5c9c5"

# notifications
set notification-bg          "#8a9a7b"
set notification-fg          "#12120f"
set notification-error-bg    "#c4746e"
set notification-error-fg    "#12120f"
set notification-warning-bg  "#b6927b"
set notification-warning-fg  "#12120f"

# search / selection highlight
set highlight-color         "#c4b28a"
set highlight-active-color  "#8ba4b0"

# completion menu
set completion-bg           "#282727"
set completion-fg           "#c5c9c5"
set completion-group-bg     "#1D1C19"
set completion-group-fg     "#9e9b93"
set completion-highlight-bg "#8ba4b0"
set completion-highlight-fg "#12120f"

set recolor "true"
set recolor-lightcolor "#181616"
set recolor-darkcolor  "#c5c9c5"
set recolor-keephue "true"
set recolor-reverse-video "true"
set render-loading "false"

set scroll-step 50
unmap f
map f toggle_fullscreen
map [fullscreen] f toggle_fullscreen
